<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Solar Calculator</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
box-sizing:border-box;
margin:0;
padding:0;
}

body{
font-family:'Poppins',sans-serif;
background:linear-gradient(120deg,#f6e7d6,#f1d2ad);
color:#222;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 8%;
}

.logo{
display:flex;
align-items:center;
gap:5px;
}

.logo h3{
margin:0;
}

.logo span{
font-weight:300;
font-size:14px;
}

nav a{
margin:0 15px;
text-decoration:none;
color:#333;
font-size:14px;
}

.btn{
background:#eee;
border:none;
padding:8px 16px;
border-radius:20px;
cursor:pointer;
}

.hero{
display:grid;
grid-template-columns:1fr 1fr;
align-items:center;
padding:40px 8%;
gap:40px;
}

.hero h1{
font-size:40px;
margin-bottom:10px;
}

.hero p{
font-size:14px;
color:#555;
margin-bottom:25px;
max-width:420px;
}

.form-box{
max-width:350px;
}

.input{
width:100%;
padding:12px 15px;
border-radius:25px;
border:1px solid #ddd;
margin-bottom:12px;
font-size:14px;
}

.primary-btn{
width:100%;
padding:12px;
border:none;
border-radius:25px;
background:#ff7a2f;
color:white;
font-weight:500;
cursor:pointer;
}

.note{
margin-top:10px;
font-size:12px;
color:#666;
}

.hero-img{
display:flex;
justify-content:center;
}

.hero-img img{
width:100%;
max-width:500px;
filter:drop-shadow(0 30px 30px rgba(0,0,0,0.2));
}

@media (max-width:900px){

.hero{
grid-template-columns:1fr;
text-align:center;
}

.form-box{
margin:auto;
}

.hero-img{
order:-1;
}

}

@media (max-width:500px){

.hero h1{
font-size:30px;
}

nav{
display:none;
}

}

</style>



<body>

<header>

<div class="logo">
<h3>Sunfox</h3>
<span>solar</span>
</div>

<nav>
<a href="#">Overview</a>
<a href="#">Calculator</a>
<a href="#">Blog</a>
<button class="btn">Contact Us</button>
</nav>

</header>

<section class="hero">

<div>

<h1>Solar Calculator</h1>

<p>A quick online tool to learn how much solar energy your home can generate.</p>

<div class="form-box">

<input class="input" placeholder="Enter address">

<input class="input" placeholder="Annual electricity usage">

<button class="primary-btn">Start Now</button>

<div class="note">⚡ Powered by Solar Data</div>

</div>

</div>

<div class="hero-img">
<img src="https://images.unsplash.com/photo-1509395176047-4a66953fd231" alt="solar panels">
</div>

</section>

</body>
</html>